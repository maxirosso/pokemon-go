{
  "expo": {
    "name": "GO Compass",
    "slug": "go-compass",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gocompass",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#080B12",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.gocompass.companion",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "GO Compass reads the Pokémon GO screenshots you choose so it can extract CP, HP and moves for you to review.",
        "NSCameraUsageDescription": "GO Compass can scan a Pokémon screen with the camera when you ask it to."
      }
    },
    "android": {
      "package": "app.gocompass.companion",
      "adaptiveIcon": {
        "backgroundColor": "#080B12",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080B12",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-notifications",
        {
          "color": "#A7F36B",
          "enableRemoteNotifications": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "GO Compass reads the Pokémon GO screenshots you choose so it can extract CP, HP and moves for you to review.",
          "cameraPermission": "GO Compass can scan a Pokémon screen with the camera when you ask it to."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": false
    },
    "extra": {
      "supabaseUrl": null,
      "supabaseAnonKey": null
    }
  }
}
